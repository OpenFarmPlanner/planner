#: accounts/admin.py
msgid "Primary email verified"
msgstr "Primäre E-Mail-Adresse bestätigt"

#: accounts/serializers.py:79
msgid "An account with this email already exists."
msgstr "Ein Konto mit dieser E-Mail-Adresse existiert bereits."

#: accounts/serializers.py:84 accounts/serializers.py:125
msgid "Passwords do not match."
msgstr "Die Passwörter stimmen nicht überein."

#: accounts/templates/accounts/emails/activation_email.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"please activate your OpenFarmPlanner account by clicking the link below:\n"
"\n"
"%(link)s\n"
"\n"
"If you did not create this account, you can ignore this email."
msgstr ""
"Hallo,\n"
"\n"
"bitte aktiviere deinen OpenFarmPlanner-Account über den folgenden Link:\n"
"\n"
"%(link)s\n"
"\n"
"Falls du dieses Konto nicht erstellt hast, kannst du diese E-Mail ignorieren."

#: accounts/templates/accounts/emails/password_reset_email.txt:1
#, python-format
msgid ""
"Hello,\n"
"\n"
"use the following link to reset your OpenFarmPlanner password:\n"
"\n"
"%(link)s\n"
"\n"
"If you did not request this reset, you can ignore this email."
msgstr ""
"Hallo,\n"
"\n"
"verwende den folgenden Link, um dein OpenFarmPlanner-Passwort "
"zurückzusetzen:\n"
"\n"
"%(link)s\n"
"\n"
"Falls du diese Zurücksetzung nicht angefragt hast, kannst du diese E-Mail "
"ignorieren."

#: accounts/views.py:39
msgid "If the account exists, an email has been sent."
msgstr "Falls das Konto existiert, wurde eine E-Mail gesendet."

msgid "Maximum number of attempts reached. Please try again later."
msgstr "Du hast die maximale Anzahl an Versuchen erreicht. Bitte versuche es später noch einmal."

msgid "Please wait before requesting another email."
msgstr "Bitte warte kurz, bevor du eine weitere E-Mail anforderst."

#: accounts/views.py:46
msgid "Registration successful. Please check your email to activate your account."
msgstr "Registrierung erfolgreich. Bitte prüfe deine E-Mails, um dein Konto zu aktivieren."

#: accounts/views.py:49
msgid ""
"Registration successful. In local development, the activation email is "
"written to the server log/terminal and is not delivered to an inbox."
msgstr ""
"Registrierung erfolgreich. In der lokalen Entwicklungsumgebung wird die "
"Aktivierungs-E-Mail im Server-Log/Terminal ausgegeben und nicht in ein "
"Postfach zugestellt."

#: accounts/views.py:72
msgid "Activate your OpenFarmPlanner account"
msgstr "OpenFarmPlanner-Konto aktivieren"

#: accounts/views.py:85
msgid "Reset your OpenFarmPlanner password"
msgstr "OpenFarmPlanner-Passwort zurücksetzen"

#: accounts/views.py:105
msgid "CSRF cookie set"
msgstr "CSRF-Cookie gesetzt"

#: accounts/views.py:128
msgid "Invalid activation link."
msgstr "Ungültiger Aktivierungslink."

#: accounts/views.py:133
msgid "Invalid or expired activation token."
msgstr "Ungültiges oder abgelaufenes Aktivierungs-Token."

#: accounts/views.py:153
msgid "Invalid credentials."
msgstr "Ungültige Zugangsdaten."

#: accounts/views.py:156
msgid "Account is not activated yet."
msgstr "Das Konto ist noch nicht aktiviert."

#: accounts/views.py:165
msgid "Logged out."
msgstr "Abgemeldet."

#: accounts/views.py:173
msgid "Authentication credentials were not provided."
msgstr "Authentifizierungsdaten wurden nicht bereitgestellt."

#: accounts/views.py:215 accounts/views.py:219
msgid "Invalid reset link."
msgstr "Ungültiger Zurücksetzungslink."

#: accounts/views.py:223
msgid "Invalid or expired reset token."
msgstr "Ungültiges oder abgelaufenes Zurücksetzungs-Token."

#: accounts/views.py:227
msgid "Password has been reset successfully."
msgstr "Das Passwort wurde erfolgreich zurückgesetzt."

#: accounts/social_views.py
msgid "This login method is not connected to your account."
msgstr "Diese Anmeldemethode ist nicht mit deinem Konto verknüpft."

#: accounts/social_views.py
msgid "You cannot remove your last login method. Set a password first."
msgstr ""
"Du kannst deine letzte Anmeldemethode nicht entfernen. Lege zuerst ein "
"Passwort fest."

#: accounts/social_views.py
msgid "The login method was disconnected."
msgstr "Die Anmeldemethode wurde entfernt."
